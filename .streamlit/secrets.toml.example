# Copy into the "Secrets" box of your Streamlit Community Cloud app
# (or to .streamlit/secrets.toml locally; that file is never committed).

# Where the app downloads its data and models on first start (see DEPLOY.md, step 2)
CRICKET_AI_BUNDLE_URL = "https://github.com/koushikchoudhury/cricket-ai/releases/download/data-v1/cricket-ai-ipl.zip"

# Language model for the Ask and Agent pages. Recommended: Groq's free tier (no card).
GROQ_API_KEY = "gsk_..."
CRICKET_AI_LLM = "groq"
# Paid alternatives (use one instead):
# ANTHROPIC_API_KEY = "sk-ant-..."
# CRICKET_AI_LLM = "anthropic"
# OPENAI_API_KEY = "sk-..."
# CRICKET_AI_LLM = "openai"

# Questions allowed per day (all visitors together) and per visitor. Beyond these, answers
# show the retrieved sources only. Groq's free tier allows about 200,000 tokens a day for
# gpt-oss-120b and one question uses roughly 3,000-5,000, so 30 a day stays well inside it.
CRICKET_AI_DAILY_LIMIT = "30"
CRICKET_AI_SESSION_LIMIT = "10"
